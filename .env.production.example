# Copy to .env on the server and fill in. Never commit the real file.
ENVIRONMENT=production
AUTH_MODE=accounts
# Only people with an email in these domains can create an account.
ALLOWED_EMAIL_DOMAINS=panscience.ai
# These people manage the company hub and see pilot feedback (the first account is admin if this is empty).
ADMIN_EMAILS=
# Your site's address exactly as people type it.
CORS_ALLOWED_ORIGINS=https://pitchlight.example.com
COOKIE_SECURE=true
SESSION_DAYS=30

GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
GEMINI_BACKEND=gemini
LOCAL_DB_PATH=/app/data/pitchmirror.db
GOOGLE_CLOUD_PROJECT=

# Cost guards
ENABLE_IMAGE_GENERATION=false
MEETING_MAX_MINUTES=60

# Per-person limits (signed-in people are counted by account, not by network address)
WS_MAX_CONCURRENT_PER_USER=2
WS_MAX_CONNECTIONS_PER_MINUTE=30
HTTP_MAX_REQUESTS_PER_MINUTE=240
