{
  "manifest_version": 3,
  "name": "Pitchlight meeting coach",
  "short_name": "Pitchlight",
  "version": "0.1.0",
  "description": "Start Pitchlight in any browser meeting (Google Meet, Teams, Zoom on the web) so the coach hears both sides.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pitchlight",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["tabCapture", "offscreen", "activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "start-coaching": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Start Pitchlight on the meeting in this tab"
    }
  }
}
